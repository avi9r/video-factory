# API keys (copy to config.env)
GROQ_API_KEY=your_groq_key_here
HF_API_KEY=your_hf_token_here
# HF token: Inference Providers credits OR use FAL_API_KEY for FLUX images
FAL_API_KEY=your_fal_key_here
FAL_KEY=your_fal_key_here
PEXELS_API_KEY=          # recommended fallback when FLUX unavailable

# Model / server (optional overrides)
# Script LLM: groq (default, chunked to fit free TPM) | gemini (free API) | ollama (local)
SCRIPT_PROVIDER=groq
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=your_gemini_key_here
GEMINI_MODEL=gemini-2.0-flash
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.3
API_HOST=0.0.0.0
API_PORT=8002

# Paths
OUTPUT_BASE=/Volumes/more_work/youtube-factory/output
MUSIC_BASE=/Volumes/more_work/youtube-factory/music
LUT_BASE=/Volumes/more_work/youtube-factory/luts
CHANNELS_BASE=/Volumes/more_work/youtube-factory/channels
